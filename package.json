    "globals": "^16.5.0",
    "js-yaml": "^4.1.0",
    "knip": "^6.23.0",
    "minimatch": "^10.0.0",
    "nx": "^22.0.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.51.0",
    "typescript": "^7.0.1-0"
  },
  "resolutions": {
    "@appium/base-driver/axios": "^1.15.0",
    "@appium/base-driver/lodash": "^4.18.1",
    "@appium/base-driver/lru-cache": "^11.3.5",
    "@appium/base-driver/path-to-regexp": "^8.4.2",
    "@appium/docutils": "ignore:",

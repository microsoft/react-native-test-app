  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "yarn@4.13.0",
  "rnx-kit": {
    "lint": {
      "lockfile": {
        "noDuplicates": {
          "packages": [
            "@babel/core"
          ]
        }
      }
    }
  }
